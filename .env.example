# Скопируйте в .env и подставьте свои значения:  cp .env.example .env

# База. Строка есть — работает Postgres, нет — файловый SQLite.
# Локальный Postgres поднимается из compose.yaml: docker compose up -d
DATABASE_URL=postgresql://tvoy_magazin:tvoy_magazin@127.0.0.1:5433/tvoy_magazin

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_VISION_MODEL=openai/gpt-5.6-luna
OPENROUTER_MATCH_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-vl-235b-a22b-instruct
OPENROUTER_TIMEOUT=180
INVOICE_PARSE_CONCURRENCY=3

INVOICE_PARSE_INLINE=
# Access ходит в каждом запросе и живёт мало; протух — фронт молча меняет его
# по refresh. Долгий access тут не нужен и только расширяет окно для краденого.
ACCESS_TOKEN_HOURS=1
REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Отладка: трейсбеки в браузере. В проде не включать — страница ошибки
# показывает все настройки, включая ключ OpenRouter и пароль базы.
DJANGO_DEBUG=1

# Для продакшена задать обязательно:
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=
# Домен, с которого работает админка (иначе вход не пройдёт проверку CSRF):
# CSRF_TRUSTED_ORIGINS=https://tvoymagazinapi-production.up.railway.app
# Папка на примонтированном томе: без неё фотографии накладных исчезнут
# при следующем деплое вместе с контейнером.
# DJANGO_MEDIA_ROOT=/data/media
